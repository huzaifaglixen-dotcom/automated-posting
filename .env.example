# Copy to .env and fill in. NEVER commit .env.
# Platforms with missing credentials are reported as "failed" and skipped;
# the remaining platforms are still posted to.

# 1. Telegram (create bot via @BotFather, add it as admin to your channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_public_channel   # or numeric chat id

# 2. Discord (Server Settings > Integrations > Webhooks > Copy Webhook URL)
DISCORD_WEBHOOK_URL=
DISCORD_GUILD_ID=                        # optional, used to build the message link

# 3. Mastodon (Preferences > Development > New application, scope: write:statuses)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# 4. Bluesky (Settings > App Passwords; do NOT use your main password)
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# 5. DEV Community / Forem (Settings > Extensions > Generate API key)
DEVTO_API_KEY=

# Optional
REQUEST_TIMEOUT_SECONDS=15
